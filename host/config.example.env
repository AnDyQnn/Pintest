# ---- host/config.env (скопируй из этого файла) ---------------------
# Всё поведение хоста — через ENV: одинаково в лабе и на реальном сервере.

# Доступ к вебке (подразумевается через админский VPN-конфиг).
# ЭТО ИСТОЧНИК ИСТИНЫ ДЛЯ АДМИН-ВХОДА: применяется на КАЖДОМ старте бэкенда.
# Поменял тут креды + пересоздал/перезапустил контейнеры → входишь под новыми.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=change-me-in-real-lab

# Админский VPN: full-tunnel = через VPN идёт И вебка, И интернет (сервер NAT'ит наружу).
# 1 (по умолч.) — полный туннель; 0 — только доступ к панели/сети управления (split).
ADMIN_VPN_FULL_TUNNEL=1
ADMIN_VPN_DNS=1.1.1.1, 1.0.0.1

# Хардненинг: порт SSH хоста. install.sh откроет его в ufw (а НЕ хардкод 22).
# Меняешь порт sshd — впиши тот же сюда, иначе ufw закроет доступ. fail2ban ловит
# перебор через journald независимо от порта.
SSH_PORT=22

# VPN / туннель
HOST_TUNNEL_IP=10.9.0.1
AWG_LISTEN_PORT=51820
# Адрес хоста, куда дозваниваются агенты. МОЖНО НЕ ЗАДАВАТЬ — определится сам
# (внешний сервис → IP исходящего интерфейса). Задай ЯВНО, только если авто-детект
# ошибается (сложный NAT/несколько адресов), напр.: AWG_ENDPOINT=203.0.113.7:51820
# AWG_ENDPOINT=
# AWG_NO_EXTERNAL=1   # закрытый лаб без интернета: не ходить во внешний сервис, брать IP интерфейса

# Оркестрация
CHUNK_SIZE=4          # целей в чанке (мельче = нагляднее раздача/failover)
