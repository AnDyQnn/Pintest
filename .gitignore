# ===================================================================
#  Корневой .gitignore для всей системы (pintest + host + agent + lab)
#  Папка pintest/ имеет свой .gitignore для отдельной выкачки.
# ===================================================================

# --- результаты прогонов аудита ---
audit_*/
*.audit/

# --- реальные списки целей: НЕ коммитим (в репо только *.sample.txt) ---
targets.txt
123.txt
*.targets
scope.txt
hosts.txt
t.txt
tmp*.txt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- секреты и рантайм-состояние системы ---
# ключи AmneziaWG/WireGuard, самоподписанные сертификаты — генерируются на старте
*.key
*.pem
*.crt
*_privatekey
*_publickey
# данные на диске (volumes): отчёты, БД, ключи, бэкапы, сертификаты
data/
host/data/
lab/data/
agent/state/*
!agent/state/.gitkeep

# --- локальные конфиги/оверрайды (в репо — только *.example) ---
.env
*.local.env
docker-compose.override.yml

# --- логи/состояние ---
*.log
*.pid
status.json

# --- ОС / редакторы ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
