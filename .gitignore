# ===================================================================
#  Корневой .gitignore для всей системы (pintest + host + agent + lab)
#  Папка pintest/ имеет свой .gitignore для отдельной выкачки.
# ===================================================================

# --- результаты прогонов аудита ---
audit_*/
*.audit/

# --- реальные списки целей: НЕ коммитим (в репо только *.sample.txt) ---
targets.txt
123.txt
*.targets
scope.txt
hosts.txt
t.txt
tmp*.txt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- секреты и рантайм-состояние системы ---
# ключи AmneziaWG/WireGuard, самоподписанные сертификаты — генерируются install.sh
*.key
*.pem
*.crt
*_privatekey
*_publickey
host/webui/certs/*
!host/webui/certs/.gitkeep
# рантайм-состояние control plane (реестр агентов, джобы, бэкапы)
host/webui/state/*
!host/webui/state/.gitkeep
agent/state/*
!agent/state/.gitkeep

# --- локальные конфиги/оверрайды (в репо — только *.example) ---
.env
*.local.env
docker-compose.override.yml

# --- логи/состояние ---
*.log
*.pid
status.json

# --- ОС / редакторы ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
