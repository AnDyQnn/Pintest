# ---- agent/config.env (скопируй из этого файла) --------------------
# Всё поведение ноды — через ENV: одинаково в лабе и на реальном сервере.

# SSH для provisioning с хоста (хост вводит эти креды в вебке)
AGENT_SSH_USER=root
AGENT_SSH_PASSWORD=pintest

# Сеть/туннель
AGENT_API_PORT=9101
AWG_IFACE=awg0
HOST_TUNNEL_IP=10.9.0.1        # адрес хоста внутри AmneziaWG

# Dead-man switch: секунд без связи с хостом до самоуничтожения
DEADMAN_ENABLED=1
DEADMAN_TIMEOUT=20
DEADMAN_INTERVAL=3

# Имя ноды (для UI). По умолчанию — hostname контейнера.
# AGENT_NAME=agent-de-1
PINTEST_VERSION=0.1.0
